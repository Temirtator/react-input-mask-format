{
  "name": "react-input-mask-format",
  "description": "Input masks for React: phones, dates, cards, numbers, time and country presets. A maintained fork of react-input-mask.",
  "version": "2.15.0",
  "type": "module",
  "homepage": "https://github.com/Temirtator/react-input-mask-format",
  "license": "MIT",
  "author": "Temirlan Shagyrov <sh.temirlan95@gmail.com>",
  "keywords": [
    "react",
    "input",
    "mask",
    "masked",
    "react-component",
    "presets",
    "russia",
    "inn",
    "snils",
    "ogrn",
    "kazakhstan",
    "uzbekistan",
    "pinfl",
    "kyrgyzstan",
    "belarus",
    "tajikistan",
    "armenia",
    "azerbaijan",
    "georgia",
    "moldova",
    "ukraine",
    "turkmenistan",
    "unp",
    "voen",
    "date",
    "card",
    "credit-card",
    "react-input-mask",
    "input-mask",
    "mask-input",
    "phone",
    "phone-mask",
    "number-format",
    "currency",
    "time",
    "hook",
    "typescript",
    "iban"
  ],
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "4.10.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.d.ts",
        "default": "./dist/rsc/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
      "require": {
        "types": "./dist/presets.d.cts",
        "default": "./dist/presets.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./number": {
      "react-server": {
        "types": "./dist/number.d.ts",
        "default": "./dist/rsc/number.js"
      },
      "import": {
        "types": "./dist/number.d.ts",
        "default": "./dist/number.js"
      },
      "require": {
        "types": "./dist/number.d.cts",
        "default": "./dist/number.cjs"
      }
    },
    "./time": {
      "react-server": {
        "types": "./dist/time.d.ts",
        "default": "./dist/rsc/time.js"
      },
      "import": {
        "types": "./dist/time.d.ts",
        "default": "./dist/time.js"
      },
      "require": {
        "types": "./dist/time.d.cts",
        "default": "./dist/time.cjs"
      }
    },
    "./date": {
      "react-server": {
        "types": "./dist/date.d.ts",
        "default": "./dist/rsc/date.js"
      },
      "import": {
        "types": "./dist/date.d.ts",
        "default": "./dist/date.js"
      },
      "require": {
        "types": "./dist/date.d.cts",
        "default": "./dist/date.cjs"
      }
    },
    "./card": {
      "react-server": {
        "types": "./dist/card.d.ts",
        "default": "./dist/rsc/card.js"
      },
      "import": {
        "types": "./dist/card.d.ts",
        "default": "./dist/card.js"
      },
      "require": {
        "types": "./dist/card.d.cts",
        "default": "./dist/card.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "presets": [
        "./dist/presets.d.ts"
      ],
      "validators": [
        "./dist/validators.d.ts"
      ],
      "number": [
        "./dist/number.d.ts"
      ],
      "time": [
        "./dist/time.d.ts"
      ],
      "date": [
        "./dist/date.d.ts"
      ],
      "card": [
        "./dist/card.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6.5 KB"
    },
    {
      "path": "dist/presets.js",
      "limit": "2 KB"
    },
    {
      "path": "dist/validators.js",
      "limit": "2 KB"
    },
    {
      "path": "dist/number.js",
      "limit": "3.5 KB"
    },
    {
      "path": "dist/time.js",
      "limit": "3 KB"
    },
    {
      "path": "dist/date.js",
      "limit": "3.5 KB"
    },
    {
      "path": "dist/card.js",
      "limit": "3.5 KB"
    },
    {
      "name": "index { useMask }",
      "path": "dist/index.js",
      "import": "{ useMask }",
      "limit": "5 KB"
    },
    {
      "name": "index { extendedFormatChars }",
      "path": "dist/index.js",
      "import": "{ extendedFormatChars }",
      "limit": "0.4 KB"
    },
    {
      "name": "number { formatNumber }",
      "path": "dist/number.js",
      "import": "{ formatNumber }",
      "limit": "1 KB"
    },
    {
      "name": "number { useNumberFormat }",
      "path": "dist/number.js",
      "import": "{ useNumberFormat }",
      "limit": "2.5 KB"
    },
    {
      "name": "time { formatTime }",
      "path": "dist/time.js",
      "import": "{ formatTime }",
      "limit": "0.45 KB"
    },
    {
      "name": "date { formatDate }",
      "path": "dist/date.js",
      "import": "{ formatDate }",
      "limit": "0.8 KB"
    },
    {
      "name": "card { detectCardBrand }",
      "path": "dist/card.js",
      "import": "{ detectCardBrand }",
      "limit": "0.75 KB"
    },
    {
      "name": "card { CardNumberFormat }",
      "path": "dist/card.js",
      "import": "{ CardNumberFormat }",
      "limit": "2.5 KB"
    },
    {
      "name": "presets { kzPhone }",
      "path": "dist/presets.js",
      "import": "{ kzPhone }",
      "limit": "0.15 KB"
    }
  ],
  "scripts": {
    "build": "tsup",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Temirtator/react-input-mask-format.git"
  }
}
