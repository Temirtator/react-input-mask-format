{
  "name": "react-input-mask-format",
  "description": "Masked input component for React",
  "version": "2.7.1",
  "type": "module",
  "homepage": "https://github.com/Temirtator/react-input-mask-format",
  "license": "MIT",
  "author": "Temirlan Shagyrov <sh.temirlan95@gmail.com>",
  "keywords": [
    "react",
    "input",
    "mask",
    "masked",
    "react-component",
    "presets",
    "russia",
    "inn",
    "snils",
    "ogrn",
    "kazakhstan",
    "uzbekistan",
    "pinfl",
    "kyrgyzstan"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "publint": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./presets": {
      "import": { "types": "./dist/presets.d.ts", "default": "./dist/presets.js" },
      "require": { "types": "./dist/presets.d.cts", "default": "./dist/presets.cjs" }
    },
    "./validators": {
      "import": { "types": "./dist/validators.d.ts", "default": "./dist/validators.js" },
      "require": { "types": "./dist/validators.d.cts", "default": "./dist/validators.cjs" }
    },
    "./number": {
      "import": { "types": "./dist/number.d.ts", "default": "./dist/number.js" },
      "require": { "types": "./dist/number.d.cts", "default": "./dist/number.cjs" }
    },
    "./time": {
      "import": { "types": "./dist/time.d.ts", "default": "./dist/time.js" },
      "require": { "types": "./dist/time.d.cts", "default": "./dist/time.cjs" }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "size-limit": [
    { "path": "dist/index.js", "limit": "6 KB" },
    { "path": "dist/presets.js", "limit": "2 KB" },
    { "path": "dist/validators.js", "limit": "2 KB" },
    { "path": "dist/number.js", "limit": "2.5 KB" },
    { "path": "dist/time.js", "limit": "2 KB" }
  ],
  "scripts": {
    "build": "tsup",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Temirtator/react-input-mask-format.git"
  }
}
