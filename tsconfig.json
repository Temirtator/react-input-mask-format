{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "react-input-mask-format": ["./src/index.tsx"],
      "react-input-mask-format/presets": ["./src/presets/index.ts"],
      "react-input-mask-format/validators": ["./src/validators/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx",
    "tests/**/*.ts", "tests/**/*.tsx",
    "demo/**/*.ts", "demo/**/*.tsx",
    "e2e/**/*.ts", "*.config.ts"
  ]
}
